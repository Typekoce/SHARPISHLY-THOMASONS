cat <<EOF > .gitignore
# --- System / IDE ---
.DS_Store
.vscode/
.idea/
*.swp
*.bak

# --- Environment & Secrets ---
.env
.env.local
.env.*.local

# --- Centralized Storage ---
storage/**/*
!storage/**/.gitkeep
storage/ollama/
storage/qdrant/
mysql_data/

# --- Python / AI Infrastructure ---
__pycache__/
*.pyc
ai/venv/
.pytest_cache/

# --- Web & PHP ---
web/php/logs/*.log

# --- Automation & Redundancy ---
shells/
create_neural_pipeline.sh

# --- Legacy / Database Artifacts ---
database/neo4j/
bin/
*.class
*.transaction.db.*

# --- Logs ---
*.log
storage/log/*.log
EOF
