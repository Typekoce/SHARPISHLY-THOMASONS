# --- System / IDE ---
.DS_Store
.vscode/
.idea/

# --- Environment & Secrets ---
.env
.env.local
.env.*.local

# --- Centralized Storage ---
# We keep the folders but ignore the contents
storage/uploads/*
storage/exports/*
storage/backups/*
storage/temp/*
!storage/**/.gitkeep
storage/
./storage
# --- LLM / AI Infrastructure ---
# Ignore massive model weights and vector indexes
llm/ollama/*
llm/vectordb/*
ai/venv/
__pycache__/
*.pyc
!llm/**/.gitkeep

# --- Web Application ---
web/php/logs/*.log
web/php/vendor/
node_modules/

# --- NEO4J ----
# Database Data (Heavy Assets)
database/neo4j/data/
mysql_data/
storage/ollama/

# Transaction Logs
*.transaction.db.*
*.log
database/neo4j/data/
*.transaction.db.*
