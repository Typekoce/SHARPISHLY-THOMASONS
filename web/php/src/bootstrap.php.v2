<?php
declare(strict_types=1);

/**
 * THOMASONS V3 – Bootstrap
 * PSR-4 Autoloader + Core Service Initialization
 * Location: web/php/src/bootstrap.php
 */

namespace App;

// ────────────────────────────────────────────────
// 1. Define immutable core paths (absolute, trailing slash)
define('APP_ROOT',   dirname(__DIR__, 3) . '/');
define('SRC_ROOT',   __DIR__ . '/');
define('LOGS_DIR',   APP_ROOT . 'storage/logs/');

// Ensure logs directory exists (very early fail-fast)
if (!is_dir(LOGS_DIR) && !mkdir(LOGS_DIR, 0755, true)) {
    die("Cannot create logs directory: " . LOGS_DIR);
}

// ────────────────────────────────────────────────
// 2. PSR-4 Autoloader (only for App\ namespace)
spl_autoload_register(function (string $class): void {
    $prefix    = 'App\\';
    $base_dir  = SRC_ROOT;
    $prefixLen = strlen($prefix);

    if (strncmp($prefix, $class, $prefixLen) !== 0) {
        return;
    }

    $relative = substr($class, $prefixLen);
    $file     = $base_dir . str_replace('\\', '/', $relative) . '.php';

    if (file_exists($file)) {
        require_once $file;
    }
});

// ────────────────────────────────────────────────
// 3. Simple singleton-style registry (lives in App\)
class Registry
{
    private static array $instances = [];

    /**
     * Get (and lazily create) a service instance
     */
    public static function get(string $class, ...$args): object
    {
        $class = ltrim($class, '\\');

        if (!isset(self::$instances[$class])) {
            if (!class_exists($class)) {
                throw new \RuntimeException("Class not found: $class");
            }
            self::$instances[$class] = new $class(...$args);
        }

        return self::$instances[$class];
    }

    /**
     * Optional: replace an instance (useful for testing)
     */
    public static function set(string $class, object $instance): void
    {
        self::$instances[ltrim($class, '\\')] = $instance;
    }
}

// ────────────────────────────────────────────────
// 4. Early initialization of critical services
use App\Services\Location;

$location = Registry::get(Location::class);

// Make sure we can write to logs
if (!is_writable(LOGS_DIR)) {
    die("Logs directory is not writable: " . LOGS_DIR);
}

// ────────────────────────────────────────────────
// 5. Centralized error & exception handling
set_error_handler(function (
    int $errno,
    string $errstr,
    string $errfile,
    int $errline
) use ($location): bool {
    $logFile = $location->logs('system.log');

    $message = sprintf(
        "[%s] PHP Error [%d]: %s in %s:%d\n",
        date('Y-m-d H:i:s'),
        $errno,
        $errstr,
        $errfile,
        $errline
    );

    file_put_contents($logFile, $message, FILE_APPEND | LOCK_EX);

    // In production, you might want to return true to suppress display
    return false; // let PHP show it in dev
});

set_exception_handler(function (\Throwable $e) use ($location): void {
    $logFile = $location->logs('system.log');

    $message = sprintf(
        "[%s] Uncaught %s: %s in %s:%d\nStack trace:\n%s\n",
        date('Y-m-d H:i:s'),
        get_class($e),
        $e->getMessage(),
        $e->getFile(),
        $e->getLine(),
        $e->getTraceAsString()
    );

    file_put_contents($logFile, $message, FILE_APPEND | LOCK_EX);

    // In real app → render 500 page or JSON error
    if (PHP_SAPI === 'cli') {
        fwrite(STDERR, $message);
        exit(1);
    }

    http_response_code(500);
    echo "Internal Server Error – please check logs.";
    exit;
});

// Optional shutdown function to catch fatal errors
register_shutdown_function(function () use ($location): void {
    $error = error_get_last();
    if ($error && in_array($error['type'], [E_ERROR, E_PARSE, E_CORE_ERROR, E_COMPILE_ERROR], true)) {
        $logFile = $location->logs('system.log');
        $message = sprintf(
            "[%s] Fatal Error: %s in %s:%d\n",
            date('Y-m-d H:i:s'),
            $error['message'],
            $error['file'],
            $error['line']
        );
        file_put_contents($logFile, $message, FILE_APPEND | LOCK_EX);
    }
});

// ────────────────────────────────────────────────
// 6. Optional: tiny global accessor (use sparingly)
// ────────────────────────────────────────────────
// if you really want app() helper:
// function app(): Registry { return Registry::class; }  // ← returns class name
// Better: just use Registry::get() directly

// ────────────────────────────────────────────────
// Bootstrap complete – ready for index.php / CLI / workers
